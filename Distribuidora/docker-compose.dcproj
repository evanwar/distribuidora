<Project Sdk="Microsoft.Docker.Sdk">

  <PropertyGroup>
    <DockerTargetOS>Linux</DockerTargetOS>
    <ProjectVersion>2.1</ProjectVersion>
    <DockerComposeProjectName>distribuidora</DockerComposeProjectName>
    <DockerServiceName>api</DockerServiceName>
    <DockerLaunchAction>LaunchBrowser</DockerLaunchAction>
    <DockerServiceUrl>http://localhost:8080/scalar/v1</DockerServiceUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="docker-compose.yml" />
    <None Include="docker-compose.vs.debug.yml">
      <DependentUpon>docker-compose.yml</DependentUpon>
    </None>
    <None Include="src\Distribuidora.Api\Dockerfile" />
    <None Include=".dockerignore" />
    <None Include=".env.example" />
    <None Include="Properties\launchSettings.json" />
  </ItemGroup>

</Project>
