# Copia este archivo como .env para personalizar la instalación local.
WEB_PORT=4200
API_PORT=8080

POSTGRES_DB=distribuidora
POSTGRES_USER=distribuidora
POSTGRES_PASSWORD=distribuidora-local

ASPNETCORE_ENVIRONMENT=Production
JWT_ISSUER=Distribuidora.Api
JWT_AUDIENCE=Distribuidora.Client
JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=set-a-unique-admin-password-here
SEED_SYNC_ADMIN_CREDENTIALS=true

# Opcionales: déjalos vacíos si no usarás una terminal Mercado Pago Point.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_APPLICATION_ID=
MERCADO_PAGO_TERMINAL_ID=
